# PostgreSQL Configuration
POSTGRES_DB=evcharging
POSTGRES_USER=evapp
POSTGRES_PASSWORD=your_secure_db_password

# Database Host and Port
# Use 127.0.0.1 and 5433 for local Windows host development
# Docker Compose overrides DB_HOST=db and DB_PORT=5432 internally
DB_HOST=127.0.0.1
DB_PORT=5433

# Django Configuration
# Required: Django secret key for cryptographic signing
SECRET_KEY=your_django_secret_key_here
# Debug mode (0 in Docker/production by default; set to 1 for local development)
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
